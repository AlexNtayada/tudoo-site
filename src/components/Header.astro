---
import { nav } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="in nav">
    <a class="logo" href="/" aria-label="Tudoo, prima pagină">Tudoo</a>
    <nav class="links" aria-label="Meniu principal">
      {nav.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="btn dark" href="/cere-oferta"><span class="dot"></span>Cere ofertă</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">Meniu</button>
  </div>
  <nav class="in mobile-menu" id="mobile-menu" aria-label="Meniu" hidden>
    {nav.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <a class="btn dark" href="/cere-oferta"><span class="dot"></span>Cere ofertă</a>
  </nav>
</header>
