---
import { services } from '../data/site';
---
<div class="showcase">
  {services.map((s, i) => (
    <article class={`show-row${i % 2 ? ' flip' : ''}`}>
      <a class="show-media" href={`/servicii/${s.slug}`} tabindex="-1" aria-hidden="true">
        <img src={s.photo.src} alt="" loading={i < 2 ? 'eager' : 'lazy'} width="1400" height="1000" />
        <span class="show-num">{s.num}</span>
      </a>
      <div class="show-body">
        <h2><a href={`/servicii/${s.slug}`}>{s.title}</a></h2>
        <p class="show-lead">{s.intro}</p>
        <ul class="checks">{s.bullets.slice(0, 4).map((b) => <li>{b}</li>)}</ul>
        <a class="btn dark" href={`/servicii/${s.slug}`}>Află mai mult</a>
        <p class="show-credit">Foto: <a href={`${s.photo.link}?utm_source=tudoo&utm_medium=referral`} rel="noopener">{s.photo.by}</a> / <a href="https://unsplash.com/?utm_source=tudoo&utm_medium=referral" rel="noopener">Unsplash</a></p>
      </div>
    </article>
  ))}
</div>
