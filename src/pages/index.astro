---
import Base from '../layouts/Base.astro';
import MiniSite from '../components/MiniSite.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Cta from '../components/Cta.astro';
import { company, minis, steps } from '../data/site';

const tileOrder = [0, 3, 6, 1, 4, 5];
const depth = [.9, .5, 1.3, .6, 1.1, 1.5];
const reel = [6, 4, 2, 5, 1, 7, 0, 3];
const featured = [
  { m: 6, title: 'Cabinet stomatologic', tags: ['Site de prezentare', 'Programări online'], bg: 'linear-gradient(135deg,#2F4BFF,#7B8CFF)' },
  { m: 4, title: 'Cafenea de cartier', tags: ['Logo', 'Landing page'], bg: '#FFD84D' },
  { m: 2, title: 'Atelier de ceramică', tags: ['Magazin online'], bg: 'var(--night)' },
];
---
<Base title="Tudoo" description="Site-uri, aplicații, design UI/UX și logo-uri pentru firme mici, la preț fix. Landing page de la 900 €, livrat în 10 zile lucrătoare.">
  <section class="mosaic">
    <div class="mosaic-c in">
      <span class="status"><i></i>{company.status}</span>
      <h1 data-split>Firma ta merită <em>un site pe măsură.</em></h1>
      <p class="lead">Nu șabloane. Site-uri și aplicații desenate pentru clienții tăi, livrate în 2–3 săptămâni.</p>
      <div class="ctas"><a class="btn dark" href="/cere-oferta"><span class="dot"></span>Programează o discuție</a><a class="btn ghost" href="/preturi">Vezi prețurile</a></div>
    </div>
    <div class="tiles" aria-hidden="true">
      {tileOrder.map((k, i) => (
        <div class="tile" data-d={depth[i]}><div class="tp"><MiniSite site={minis[k]} badge={i % 2 === 0} /></div></div>
      ))}
    </div>
  </section>

  <section aria-label="Exemple de site-uri">
    <div class="reel" id="reel">
      <div class="track">
        {reel.map((k, i) => <div class="shot"><MiniSite site={minis[k]} wide={i % 2 === 1} /></div>)}
      </div>
    </div>
    <div class="drag-cursor" aria-hidden="true"><span>Trage</span></div>
  </section>

  <section class="in manifesto">
    <span class="lab">De ce Tudoo</span>
    <div class="txt">
      <p>Credem că și o firmă mică merită un site care arată bine, se încarcă repede și aduce clienți.</p>
      <p class="m">Nu vindem ore și nici „soluții digitale”. Vindem lucruri terminate: un site, o aplicație, un logo. Știi prețul de la început și vezi progresul în fiecare săptămână.</p>
      <p>Fiecare detaliu, bifat.</p>
      <span class="sig">Echipa Tudoo</span>
    </div>
  </section>

  <section class="in sec" id="servicii">
    <div class="sec-head"><h2>Tot ce-ți trebuie online.</h2><a class="link" href="/preturi">Toate prețurile</a></div>
    <ServiceCards only={['site-uri', 'ui-ux', 'logo-brand']} />
  </section>

  <section class="in sec">
    <div class="sec-head"><h2>Cum ar putea arăta.</h2><a class="link" href="/portofoliu">Vezi portofoliul</a></div>
    <div class="projects">
      {featured.map((p, i) => (
        <a class:list={['proj', { wide: i === 0 }]} href="/portofoliu">
          <div class="vis" style={`background:${p.bg}`}><MiniSite site={minis[p.m]} wide /></div>
          <div class="meta"><h3>{p.title}</h3><div class="tags"><span class="concept">Concept</span>{p.tags.map((t) => <span>{t}</span>)}</div></div>
        </a>
      ))}
    </div>
  </section>

  <section class="in sec">
    <div class="sec-head"><h2>De la discuție la lansare.</h2><a class="link" href="/cum-lucram">Cum lucrăm</a></div>
    <ol class="steps" data-stagger>
      {steps.slice(0, 4).map((s) => <li><b>{s.t}</b><span>{s.d}</span></li>)}
    </ol>
  </section>

  <Cta />
</Base>
